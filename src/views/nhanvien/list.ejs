<div class="d-flex justify-content-between align-items-center mb-4">
  <h3>Danh sách nhân viên</h3>
  <a href="/nhanvien/add" class="btn btn-primary">
    <i class="fa-solid fa-plus"></i> Thêm nhân viên
  </a>
</div>

<table class="table table-striped table-bordered align-middle">
  <thead class="table-light">
    <tr>
      <th>Tên</th>
      <th>Tuổi</th>
      <th>Chức vụ</th>
      <th>Lương (VNĐ)</th>
      <th>Địa chỉ</th>
      <th class="text-center">Hành động</th>
    </tr>
  </thead>
  <tbody>
    <% nhanviens.forEach(nv => { %>
      <tr>
        <td><%= nv.ten %></td>
        <td><%= nv.tuoi %></td>
        <td><%= nv.chucvu %></td>
        <td><%= nv.luong.toLocaleString() %></td>
        <td><%= nv.diachi %></td>
        <td class="text-center">
          <a href="/nhanvien/edit/<%= nv._id %>" class="btn btn-sm btn-warning">Sửa</a>
          <a href="/nhanvien/delete/<%= nv._id %>" class="btn btn-sm btn-danger"
             onclick="return confirm('Bạn có chắc muốn xóa nhân viên này?');">Xóa</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
